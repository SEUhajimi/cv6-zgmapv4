<?xml version="1.0" encoding="utf-8"?>
<Mod id="f6b2569b-327f-4e5f-93b4-7be11649accb" version="1">
	<Properties>
		<Name>Warring States China Map V4.0</Name>
		<Teaser>Standard-size Warring States China for 2-5 player PvP.</Teaser>
		<Description>Fixed-terrain Warring States China map (Standard 84x54), balanced starts for 2-5 player PvP. V4.0 2026-11-01.</Description>
		<Authors>Hhhajimi</Authors>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<!-- 只在选了这张地图时加载游戏内脚本 -->
		<Criteria id="ZhanguoV4_Map">
			<ConfigurationValueMatches>
				<Group>Map</Group>
				<ConfigurationId>MAP_SCRIPT</ConfigurationId>
				<Value>{f6b2569b-327f-4e5f-93b4-7be11649accb}ZhanguoV4.lua</Value>
			</ConfigurationValueMatches>
		</Criteria>
	</ActionCriteria>
	<FrontEndActions>
		<UpdateDatabase id="ZHANGUOV4_MAP_CONFIG">
			<File>ZhanguoV4.xml</File>
		</UpdateDatabase>
		<UpdateDatabase id="ZHANGUOV4_MAP_SIZE">
			<File>ZhanguoV4_Size.xml</File>
		</UpdateDatabase>
		<UpdateText id="ZHANGUOV4_MAP_TEXT">
			<File>ZhanguoV4_Text.xml</File>
		</UpdateText>
		<ImportFiles id="ZHANGUOV4_MAP_FILE_FE">
			<File>ZhanguoV4.lua</File>
		</ImportFiles>
	</FrontEndActions>
	<InGameActions>
		<UpdateText id="ZHANGUOV4_MAP_TEXT_IG">
			<File>ZhanguoV4_Text.xml</File>
		</UpdateText>
		<ImportFiles id="ZHANGUOV4_MAP_FILE_IG">
			<File>ZhanguoV4.lua</File>
		</ImportFiles>
		<!-- 城市历史地名、北方蛮族营地 -->
		<UpdateText id="ZHANGUOV4_CITY_NAMES" criteria="ZhanguoV4_Map">
			<File>ZhanguoV4_CityNames.xml</File>
		</UpdateText>
		<AddGameplayScripts id="ZHANGUOV4_GAMEPLAY" criteria="ZhanguoV4_Map">
			<File>ZhanguoV4_Gameplay.lua</File>
		</AddGameplayScripts>
	</InGameActions>
	<Files>
		<File>ZhanguoV4.lua</File>
		<File>ZhanguoV4.xml</File>
		<File>ZhanguoV4_Size.xml</File>
		<File>ZhanguoV4_Text.xml</File>
		<File>ZhanguoV4_CityNames.xml</File>
		<File>ZhanguoV4_Gameplay.lua</File>
	</Files>
</Mod>
